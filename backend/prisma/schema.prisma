generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// USERS & PERMISSIONS
// ==========================================

model User {
  id                   String           @id @default(uuid())
  // Nullable: ERP-generated accounts log in by username until a real company
  // mailbox exists (see username below). Postgres allows multiple NULLs under
  // a unique index, so this coexists with the seeded demo accounts' emails.
  email                String?          @unique
  // The credential shown once to HR at account creation. firstname.lastname,
  // deduplicated with a numeric suffix on collision.
  username             String?          @unique
  passwordHash         String           @map("password_hash")
  // Separate from passwordHash, which is what login actually checks — this
  // is a reversible copy (AES-256-GCM, see field-encryption.ts) that exists
  // solely so Admin/HR can look up someone's current password in User
  // Management. Written alongside the hash at account creation and every
  // manual reset; never used for authentication itself. Null for any
  // account whose password predates this field — there is no way to
  // recover what was never stored, only what gets set from here on.
  passwordPlain        String?          @map("password_plain")
  // Login is refused, and every existing session is rejected on its very next
  // request (JwtStrategy re-checks this per-request), when false.
  isActive             Boolean          @default(true) @map("is_active")
  resetToken           String?          @map("reset_token")
  resetTokenExpiry     DateTime?        @map("reset_token_expiry")
  roleId               String           @map("role_id")
  role                 Role             @relation(fields: [roleId], references: [id])
  employee             Employee?
  authSessions         Authentication[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  sentAnnouncements       Announcement[]           @relation("AnnouncementAuthor")
  receivedAnnouncements   AnnouncementRecipient[]  @relation("AnnouncementRecipientUser")
  passwordResetRequests   PasswordResetRequest[]   @relation("PasswordResetRequests")
  resolvedPasswordResets  PasswordResetRequest[]   @relation("PasswordResetResolvedBy")

  // User Preferences
  theme                String           @default("light")
  language             String           @default("English (US)")
  twoFactorEnabled     Boolean          @default(false) @map("two_factor_enabled")
  emailNotifications   Boolean          @default(true) @map("email_notifications")

  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@map("users")
}

model Authentication {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  token        String   @unique
  deviceInfo   String?  @map("device_info")
  ipAddress    String?  @map("ip_address")
  isActive     Boolean  @default(true) @map("is_active")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("authentications")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  module    Module
  action    Action
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

enum Module {
  HR
  CRM
  INVENTORY
  PROJECTS
  FINANCE
  ANALYTICS
  ADMIN
  // Every role holds SELF:ALL — "manage my own leave/attendance/profile"
  // is not a departmental permission, it's a baseline capability everyone
  // has regardless of what else they can see. Routes under /self/* derive
  // the employee from the caller's JWT and never accept a client-supplied
  // id, so holding SELF:ALL can never be used to reach anyone else's record.
  SELF
}

enum Action {
  READ
  WRITE
  DELETE
  ALL
}

// ==========================================
// HR MODULE
// ==========================================

model Employee {
  id            String       @id @default(uuid())
  empCode       String?      @unique @map("emp_code")
  userId        String?      @unique @map("user_id")
  user          User?        @relation(fields: [userId], references: [id])
  firstName     String       @map("first_name")
  lastName      String       @map("last_name")
  gender        String?
  dob           DateTime?
  contact       String?
  address       String?      // "current address" in the onboarding form
  city          String?
  state         String?
  country       String?

  // Set the moment status becomes INACTIVE (see hrm.service.ts — the
  // transition is refused without it). Real retention math depends on this
  // existing; before this field, "leaving" recorded no date at all, which
  // is why Employee Retention on Analytics could never be a real number.
  lastWorkingDay DateTime? @map("last_working_day")

  // A directory headshot, deliberately separate from the strictly-gated
  // identity Documents pipeline (Aadhaar/PAN scans etc.) — this is meant to
  // be visible to every colleague, not locked to HR/Admin. Stored under the
  // public uploads/ path like offer letters, not private-uploads/.
  avatarUrl String? @map("avatar_url")

  // Most people's permanent address matches their current one — the
  // checkbox is the common case, permanentAddress only needs filling when
  // it's unchecked. A single free-text field rather than a full
  // city/state/country breakdown, matching how the team lead's list treats
  // it as one line item, not a structured sub-form.
  sameAsCurrentAddress Boolean @default(true) @map("same_as_current_address")
  permanentAddress     String? @map("permanent_address")

  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")

  // Education — certificates/mark sheets themselves are a Document
  // (EDUCATION_CERTIFICATE kind), not a field.
  highestQualification String? @map("highest_qualification")
  institutionName       String? @map("institution_name")
  yearOfPassing         Int?    @map("year_of_passing")

  // Previous employment — experience/relieving letters and past payslips
  // are Documents, not fields, same reasoning as education above.
  previousCompany       String? @map("previous_company")
  previousDesignation   String? @map("previous_designation")
  totalExperienceYears  Float?  @map("total_experience_years")

  // Agreements & policies. The employment agreement itself is the offer
  // letter (offerLetterDocumentId below) — no separate field needed for it.
  ndaSigned            Boolean   @default(false) @map("nda_signed")
  ndaSignedAt          DateTime? @map("nda_signed_at")
  policyAcknowledged   Boolean   @default(false) @map("policy_acknowledged")
  policyAcknowledgedAt DateTime? @map("policy_acknowledged_at")

  joinDate      DateTime     @default(now()) @map("join_date")
  empType       EmpType      @map("emp_type")
  status        EmpStatus

  // Statutory & payout identity — required to generate a payslip.
  // Kept nullable so existing rows stay valid; the payslip generator
  // refuses to run until they are filled for that employee.
  //
  // pan and aadhaarNumber hold AES-256-GCM ciphertext, not plaintext — see
  // backend/src/common/field-encryption.ts. Format validation (regex) runs
  // on the plaintext BEFORE encryption, at the service layer; the format
  // comments below describe what HR types in, not what the column contains.
  pan             String?    @map("pan")              // format AAAAA9999A, validated then encrypted
  aadhaarNumber   String?    @map("aadhaar_number")    // 12 digits, validated then encrypted
  bankAccountNo   String?    @map("bank_account_no")
  bankIfsc        String?    @map("bank_ifsc")
  personalEmail   String?    @map("personal_email")   // the address they applied from
  workMode        WorkMode   @default(ONSITE) @map("work_mode")

  // UAN/PF/ESIC are government-issued statutory tracking numbers — the same
  // *category* of data as PAN/Aadhaar (a persistent identifier that could
  // aid identity correlation if leaked), so they get the same treatment:
  // encrypted ciphertext here, decrypted only for the same HR/Admin gate.
  // NOTE: UAN is exactly 12 digits, structurally identical to Aadhaar — there
  // is no format-based way to catch the two being swapped, unlike the
  // PAN/bank-account distinction elsewhere in this file.
  uanNumber  String? @map("uan_number")  // EPFO Universal Account Number, 12 digits, validated then encrypted
  pfNumber   String? @map("pf_number")   // no fixed national format — encrypted, not format-validated
  esicNumber String? @map("esic_number") // loosely validated then encrypted

  // Nominee — a third party the employee named, not the employee's own
  // identity. Treated like Emergency Contact / Bank Account: visible to
  // general HR access, not the stricter identity gate, since these are
  // personal facts rather than a government-issued identifier.
  nomineeName     String?   @map("nominee_name")
  nomineeRelation String?   @map("nominee_relation")
  nomineeDob      DateTime? @map("nominee_dob")
  nomineePhone    String?   @map("nominee_phone")

  // Tax declaration for TDS — a financial disclosure, not an identifier, so
  // it follows the compensation gate (HR/Finance/Admin) rather than the
  // identity gate, matching how salary itself is already scoped. Not a full
  // investment-declaration workflow (Section 80C/80D/24b line items, old vs
  // new regime comparison) — that's a materially bigger feature. This is
  // the honest minimum: which regime, plus free-text notes.
  taxRegime           String? @map("tax_regime") // "OLD" or "NEW"
  taxDeclarationNotes String? @map("tax_declaration_notes")

  reportingManagerId String?   @map("reporting_manager_id")
  reportingManager   Employee? @relation(name: "ReportsTo", fields: [reportingManagerId], references: [id])
  directReports      Employee[] @relation(name: "ReportsTo")

  // Fixed-term engagements (internships, contracts) end on a known date.
  engagementEndDate DateTime? @map("engagement_end_date")

  offerLetterDocumentId String?   @unique @map("offer_letter_document_id")
  offerLetterDocument   Document? @relation(name: "EmployeeOfferLetter", fields: [offerLetterDocumentId], references: [id])

  // Onboarding identity documents (Aadhaar scan, PAN card, cancelled cheque,
  // certificates, previous employment letters). Deliberately a direct
  // employee link, not routed through userId — an employee has these files
  // whether or not they hold an ERP login, and several pre-existing seeded
  // employees have no linked User at all.
  identityDocuments Document[] @relation(name: "EmployeeIdentityDocuments")
  offerLetterSentAt     DateTime? @map("offer_letter_sent_at")
  offerLetterSendError  String?   @map("offer_letter_send_error")

  // Internship completion certificate — generated when HR approves an
  // intern whose engagementEndDate has passed. Same pattern as the offer
  // letter document link above.
  internshipCertDocumentId String?   @unique @map("internship_cert_document_id")
  internshipCertDocument   Document? @relation(name: "EmployeeInternshipCert", fields: [internshipCertDocumentId], references: [id])
  internshipCertSentAt     DateTime? @map("internship_cert_sent_at")
  internshipCertStatus     String?   @map("internship_cert_status") // "APPROVED" | "REJECTED" | null (pending)

  departmentId  String       @map("department_id")
  department    Department   @relation(fields: [departmentId], references: [id])
  
  designationId String       @map("designation_id")
  designation   Designation  @relation(fields: [designationId], references: [id])

  attendances             Attendance[]
  leaves                  Leave[]
  assignments             Assignment[]
  assignedTasks           Task[]              @relation(name: "AssignedTasks")
  performanceReviews      PerformanceReview[] @relation(name: "EmployeeReviews")
  performanceReviewsGiven PerformanceReview[] @relation(name: "EmployeeReviewers")
  payrolls                Payroll[]
  timeLogs                TimeLog[]
  salaryStructures        SalaryStructure[]
  itAccessProfile         ItAccessProfile?
  managedProjects         Project[]              @relation(name: "ProjectManager")
  authoredAnnouncements   ProjectAnnouncement[]  @relation(name: "AnnouncementAuthor")
  targetedAnnouncements   ProjectAnnouncement[]  @relation(name: "AnnouncementAudience")
  uploadedProjectDocuments ProjectDocument[]
  declaredHolidays ProjectHoliday[]
  declaredCompanyHolidays Holiday[]

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("employees")
}

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("departments")
}

model Designation {
  id          String     @id @default(uuid())
  title       String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("designations")
}

model Attendance {
  id          String           @id @default(uuid())
  employeeId  String           @map("employee_id")
  employee    Employee         @relation(fields: [employeeId], references: [id])
  date        DateTime
  status      AttendanceStatus
  checkIn     DateTime?        @map("check_in")
  checkOut    DateTime?        @map("check_out")
  hoursWorked Float?           @map("hours_worked")

  // Set only when this row was auto-created by an approved leave request —
  // lets revoking that approval delete exactly (and only) the rows it
  // created, never a day someone marked by hand for an unrelated reason.
  leaveId String? @map("leave_id")
  leave   Leave?  @relation(fields: [leaveId], references: [id])

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("attendances")
}

model Leave {
  id         String      @id @default(uuid())
  employeeId String      @map("employee_id")
  employee   Employee    @relation(fields: [employeeId], references: [id])
  leaveType  LeaveType   @map("leave_type")
  startDate  DateTime    @map("start_date")
  endDate    DateTime    @map("end_date")
  status     LeaveStatus
  reason     String
  attendanceMarks Attendance[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("leaves")
}

// ==========================================
// CRM MODULE
// ==========================================

model Lead {
  id        String      @id @default(uuid())
  name      String
  email     String?
  phone     String?
  company   String?
  status    LeadStatus
  // Where this lead came from — the "New Lead" form already asked for this,
  // but the field didn't exist here, so every submission failed outright.
  source    String?
  customer  Customer?
  followUps FollowUp[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("leads")
}

model Customer {
  id                  String          @id @default(uuid())
  name                String
  email               String?
  phone               String?
  company             String?
  // Whether this account is still a live customer or has churned — separate
  // from a Lead's own status, and from Employee.status (that one also
  // revokes login access on removal; a customer has no login here, so this
  // is a plain flag with no cascading side effects).
  status              CustomerStatus  @default(ACTIVE)
  convertedFromLeadId String?         @unique @map("converted_from_lead_id")
  lead                Lead?           @relation(fields: [convertedFromLeadId], references: [id])
  opportunities       Opportunity[]
  followUps           FollowUp[]
  supportTickets      SupportTicket[]
  salesOrders         SalesOrder[]
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@map("customers")
}

model Opportunity {
  id                String           @id @default(uuid())
  customerId        String           @map("customer_id")
  customer          Customer         @relation(fields: [customerId], references: [id])
  value             Float
  stage             OpportunityStage
  expectedCloseDate DateTime?        @map("expected_close_date")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@map("opportunities")
}

model FollowUp {
  id             String       @id @default(uuid())
  leadId         String?      @map("lead_id")
  lead           Lead?        @relation(fields: [leadId], references: [id])
  customerId     String?      @map("customer_id")
  customer       Customer?    @relation(fields: [customerId], references: [id])
  // The "Schedule Follow-up" form already asked Call/Email/Meeting/Demo,
  // but nothing on this model stored it, so every submission failed.
  type           FollowUpType @default(CALL)
  date           DateTime
  notes          String
  nextActionDate DateTime?    @map("next_action_date")
  // Null = still upcoming. Set once someone marks it done — kept as history
  // rather than deleted, same as every other status flip in this app.
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("follow_ups")
}

// ==========================================
// INVENTORY MODULE
// ==========================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id             String          @id @default(uuid())
  name           String
  sku            String          @unique
  category       String
  categoryId     String?         @map("category_id")
  categoryRel    Category?       @relation(fields: [categoryId], references: [id])
  price          Float
  costPrice      Float?          @map("cost_price")
  stockLevel     Int             @default(0) @map("stock_level")
  minStockLevel  Int             @default(0) @map("min_stock_level")
  unit           String
  status         ProductStatus
  // A software/license product — can only ever be stocked in a VIRTUAL
  // warehouse, never a REAL one. Enforced server-side wherever a warehouse
  // is assigned, not just filtered in the dropdown.
  isDigital      Boolean         @default(false) @map("is_digital")
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  warehouseStock WarehouseStock[]
  salesOrders    SalesOrder[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("products")
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactPerson  String?         @map("contact_person")
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  status         SupplierStatus  @default(ACTIVE)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("suppliers")
}

model PurchaseOrder {
  id          String     @id @default(uuid())
  orderNumber String?    @map("order_number")
  supplierId  String     @map("supplier_id")
  supplier    Supplier   @relation(fields: [supplierId], references: [id])
  productId   String     @map("product_id")
  product     Product    @relation(fields: [productId], references: [id])
  // Which warehouse the restock lands in once this PO is marked Delivered.
  // Nullable because it postdates the module's first purchase orders.
  warehouseId String?    @map("warehouse_id")
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  quantity    Int
  totalAmount Float      @default(0) @map("total_amount")
  orderDate   DateTime   @map("order_date")
  status      POStatus
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("purchase_orders")
}

model StockMovement {
  id           String         @id @default(uuid())
  productId    String         @map("product_id")
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Which warehouse a SALE was fulfilled from or a RESTOCK landed in.
  // Nullable for the same reason as PurchaseOrder.warehouseId above.
  warehouseId  String?        @map("warehouse_id")
  warehouse    Warehouse?     @relation(fields: [warehouseId], references: [id])
  changeAmount Int            @map("change_amount")
  reason       MovementReason
  date         DateTime
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("stock_movements")
}

model WarehouseStock {
  id          String    @id @default(uuid())
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([warehouseId, productId])
  @@map("warehouse_stock")
}

model RawMaterial {
  id             String                      @id @default(uuid())
  name           String
  code           String                      @unique
  unit           String
  quantity       Int                         @default(0)
  minLevel       Int                         @default(0) @map("min_level")
  status         ProductStatus               @default(ACTIVE)
  warehouseStock WarehouseRawMaterialStock[]
  movements      RawMaterialMovement[]
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")

  @@map("raw_materials")
}

// Mirrors StockMovement — Product's own movement log can't be reused here
// since its productId is required and Product-only. Every raw material
// change (via Adjust, or an initial quantity at creation) is logged as
// ADJUSTMENT; materials are never "sold," just adjusted up or down.
model RawMaterialMovement {
  id            String         @id @default(uuid())
  rawMaterialId String         @map("raw_material_id")
  rawMaterial   RawMaterial    @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  warehouseId   String?        @map("warehouse_id")
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id])
  changeAmount  Int            @map("change_amount")
  reason        MovementReason
  date          DateTime
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("raw_material_movements")
}

model WarehouseRawMaterialStock {
  id            String      @id @default(uuid())
  warehouseId   String      @map("warehouse_id")
  warehouse     Warehouse   @relation(fields: [warehouseId], references: [id])
  rawMaterialId String      @map("raw_material_id")
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  quantity      Int         @default(0)
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([warehouseId, rawMaterialId])
  @@map("warehouse_raw_material_stock")
}

// ==========================================
// PROJECTS MODULE
// ==========================================

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus
  priority    Priority
  progress    Float         @default(0)
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  tasks       Task[]
  milestones  Milestone[]
  assignments Assignment[]
  timeLogs    TimeLog[]

  // The project's staffed owner — a direct field, not an Assignment role,
  // because there is exactly one PM per project (no Team Lead tier) and
  // only HR/Admin may ever set or change it. Project-scoped authorization
  // (see projects.service.ts's isProjectManagerOf) checks this field fresh
  // on every request; it never grants anything outside this one project.
  projectManagerId String?               @map("project_manager_id")
  projectManager    Employee?            @relation(name: "ProjectManager", fields: [projectManagerId], references: [id])
  announcements     ProjectAnnouncement[]
  documents         ProjectDocument[]
  holidays          ProjectHoliday[]

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("projects")
}

model Task {
  id                 String       @id @default(uuid())
  projectId          String       @map("project_id")
  project            Project      @relation(fields: [projectId], references: [id])
  assignedEmployeeId String?      @map("assigned_employee_id")
  assignedEmployee   Employee?    @relation(name: "AssignedTasks", fields: [assignedEmployeeId], references: [id])
  title              String
  description        String?
  status             TaskStatus
  priority           Priority
  dueDate            DateTime?    @map("due_date")
  assignments        Assignment[]
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("tasks")
}

model Assignment {
  id         String    @id @default(uuid())
  taskId     String?   @map("task_id")
  task       Task?     @relation(fields: [taskId], references: [id])
  projectId  String?   @map("project_id")
  project    Project?  @relation(fields: [projectId], references: [id])
  employeeId String    @map("employee_id")
  employee   Employee  @relation(fields: [employeeId], references: [id])
  role       String?
  assignedAt DateTime  @default(now()) @map("assigned_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Stops the same person being staffed twice on one project. Only
  // enforced for project-level rows (projectId set) — task-level
  // assignment rows (taskId set, projectId null) are unaffected since
  // Postgres treats NULL as distinct in a unique constraint.
  @@unique([projectId, employeeId])
  @@map("assignments")
}

// One row = one announcement. audienceEmployeeId null means "the whole
// project team"; set means "just this one person" — the same shape as
// every other optional-recipient field in this schema (no join table
// exists anywhere else here, so this stays consistent with that).
model ProjectAnnouncement {
  id                 String    @id @default(uuid())
  projectId          String    @map("project_id")
  project            Project   @relation(fields: [projectId], references: [id])
  authorEmployeeId   String    @map("author_employee_id")
  author             Employee  @relation(name: "AnnouncementAuthor", fields: [authorEmployeeId], references: [id])
  title              String
  body               String
  fileUrl            String?   @map("file_url")
  fileName           String?   @map("file_name")
  audienceEmployeeId String?   @map("audience_employee_id")
  audienceEmployee   Employee? @relation(name: "AnnouncementAudience", fields: [audienceEmployeeId], references: [id])
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("project_announcements")
}

// Project-level reference material — PRD, BRD, architecture diagrams,
// workflow docs. Deliberately separate from the identity-document pipeline
// in employee-documents.service.ts (different sensitivity class, different
// audience: everyone staffed on the project, not just HR).
model ProjectDocument {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  project            Project  @relation(fields: [projectId], references: [id])
  uploaderEmployeeId String   @map("uploader_employee_id")
  uploader           Employee @relation(fields: [uploaderEmployeeId], references: [id])
  kind               String   // PRD | BRD | ARCHITECTURE | WORKFLOW | OTHER
  fileUrl            String   @map("file_url")
  fileName           String   @map("file_name")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("project_documents")
}

model Milestone {
  id        String          @id @default(uuid())
  projectId String          @map("project_id")
  project   Project         @relation(fields: [projectId], references: [id])
  title     String
  dueDate   DateTime?       @map("due_date")
  status    MilestoneStatus
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@map("milestones")
}

model PerformanceReview {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation(name: "EmployeeReviews", fields: [employeeId], references: [id])
  quarter    String
  rating     Float
  review     String
  goals      String?
  reviewerId String   @map("reviewer_id")
  reviewer   Employee @relation(name: "EmployeeReviewers", fields: [reviewerId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("performance_reviews")
}

// ==========================================
// FINANCE MODULE
// ==========================================

model Expense {
  id          String        @id @default(uuid())
  amount      Float
  category    ExpenseCategory
  date        DateTime
  description String?
  status      ExpenseStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("expenses")
}

model Income {
  id          String   @id @default(uuid())
  amount      Float
  source      String
  date        DateTime
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("incomes")
}

model Invoice {
  id          String        @id @default(uuid())
  invoiceNo   String        @unique @map("invoice_no")
  clientId    String?       @map("client_id")
  clientName  String        @map("client_name")
  amount      Float
  // The "Create New Invoice" form already asked for this, but the column
  // didn't exist here — every submission with a description filled in
  // would have failed outright the moment this stopped silently swallowing
  // errors client-side.
  description String?
  dueDate     DateTime      @map("due_date")
  status      InvoiceStatus @default(UNPAID)
  payments    Payment[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("invoices")
}

model Budget {
  id          String   @id @default(uuid())
  department  String
  planned     Float
  actual      Float    @default(0)
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("budgets")
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String?       @map("invoice_id")
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id])
  amount    Float
  method    PaymentMethod
  date      DateTime
  status    PaymentStatus @default(COMPLETED)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

model Payroll {
  id          String        @id @default(uuid())
  employeeId  String        @map("employee_id")
  employee    Employee      @relation(fields: [employeeId], references: [id])
  baseSalary  Float         @map("base_salary")
  bonus       Float         @default(0)
  deductions  Float         @default(0)
  netPay      Float         @map("net_pay")
  payPeriod   String        @map("pay_period")
  // The actual date bounds behind payPeriod's human label — needed so the
  // attendance/leave metrics below can be (re)computed against the exact
  // real range, not parsed back out of free text. Nullable only because
  // rows created before this field existed have no real range on file.
  periodStart DateTime?     @map("period_start")
  periodEnd   DateTime?     @map("period_end")
  status      PayrollStatus @default(DRAFT)
  paymentDate DateTime?     @map("payment_date")

  // ---- Earnings (payslip section A) ----
  hra              Float @default(0) @map("hra")
  specialAllowance Float @default(0) @map("special_allowance")
  // grossTotal = baseSalary + hra + specialAllowance + bonus  — computed, never stored

  // ---- Deductions (payslip section B) ----
  tds             Float @default(0) @map("tds")
  providentFund   Float @default(0) @map("provident_fund")
  professionalTax Float @default(0) @map("professional_tax")
  lossOfPay       Float @default(0) @map("loss_of_pay")
  // totalDeductions = tds + providentFund + professionalTax + lossOfPay
  // netPay          = grossTotal - totalDeductions

  // ---- Attendance record (payslip footer) ----
  // Snapshotted at generation time so a reprinted payslip never changes.
  totalDaysInMonth   Int @default(0) @map("total_days_in_month")   // calendar days
  workingDaysInMonth Int @default(0) @map("working_days_in_month") // minus weekends & holidays
  leavesTaken        Int @default(0) @map("leaves_taken")
  effectiveWorkDays  Int @default(0) @map("effective_work_days")   // workingDays - leavesTaken

  // ---- Approval chain: HR prepares, Finance approves ----
  preparedById   String?   @map("prepared_by_id")
  approvedById   String?   @map("approved_by_id")
  approvedAt     DateTime? @map("approved_at")
  rejectedReason String?   @map("rejected_reason")

  payslipDocumentId String?   @unique @map("payslip_document_id")
  payslipDocument   Document? @relation(fields: [payslipDocumentId], references: [id])
  payslipSentAt     DateTime? @map("payslip_sent_at")
  payslipSendError  String?   @map("payslip_send_error")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([employeeId, payPeriod])
  @@map("payrolls")
}

/// An employee's agreed salary split, with history.
/// Payroll reads whichever row was in force during the pay period, so a raise
/// never silently rewrites what last month's payslip said.
model SalaryStructure {
  id               String   @id @default(uuid())
  employeeId       String   @map("employee_id")
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basic            Float
  hra              Float    @default(0)
  specialAllowance Float    @default(0) @map("special_allowance")
  // gross = basic + hra + specialAllowance — computed, never stored

  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to") // null = currently in force
  note          String?

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([employeeId, effectiveFrom])
  @@map("salary_structures")
}

/// Generated PDFs — payslips, offer letters, leave receipts, profile exports.
/// Hashed so a reissued document supersedes rather than silently overwrites.
model Document {
  id           String       @id @default(uuid())
  kind         DocumentKind
  ownerUserId  String?      @map("owner_user_id")
  storagePath  String       @map("storage_path")
  fileName     String       @map("file_name")
  sha256       String
  issuedAt     DateTime     @default(now()) @map("issued_at")
  supersedesId String?      @unique @map("supersedes_id")
  supersedes   Document?    @relation(name: "Supersedes", fields: [supersedesId], references: [id])
  supersededBy Document?    @relation(name: "Supersedes")

  // See Employee.identityDocuments — the direct link identity documents use.
  employeeId String?   @map("employee_id")
  employee   Employee? @relation(name: "EmployeeIdentityDocuments", fields: [employeeId], references: [id])

  payroll         Payroll?
  offerLetterFor       Employee? @relation(name: "EmployeeOfferLetter")
  internshipCertFor    Employee? @relation(name: "EmployeeInternshipCert")

  @@index([ownerUserId, kind])
  @@map("documents")
}

/// Company-wide policy values. These exist so nothing in the offer letter or
/// payroll engine is hardcoded — HR edits them once and every document follows.
model CompanyPolicy {
  id    String @id @default(uuid())
  key   String @unique
  value String
  label String            // human-readable, shown on the HR settings screen
  unit  String?           // "months", "days", "percent"
  notes String?

  updatedById String?   @map("updated_by_id")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("company_policies")
}

/// IT onboarding: existing account identifiers the employee already has
/// (GitHub, Slack) plus an internal checklist HR/IT tick off by hand.
/// Deliberately does not call Slack/GitHub/AWS APIs to create anything —
/// per team decision, this tracks provisioning that happens outside the ERP,
/// it doesn't perform it.
model ItAccessProfile {
  id         String   @id @default(uuid())
  employeeId String   @unique @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  githubUsername String? @map("github_username")
  slackEmail     String? @map("slack_email")
  corporateEmail String? @map("corporate_email") // if distinct from their ERP login

  laptopAssigned Boolean @default(false) @map("laptop_assigned")
  laptopAssetTag String? @map("laptop_asset_tag")
  softwareNotes  String? @map("software_notes") // free text, e.g. "VS Code, Docker, Figma"

  slackInvited        Boolean @default(false) @map("slack_invited")
  githubAccessGranted Boolean @default(false) @map("github_access_granted")
  jiraAccessGranted   Boolean @default(false) @map("jira_access_granted")
  awsAccessGranted    Boolean @default(false) @map("aws_access_granted")

  notes       String?
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("it_access_profiles")
}

/// Non-working days beyond weekends. Working-day maths in India is wrong
/// without these — Republic Day, Diwali, regional Telangana holidays.
model Holiday {
  id       String   @id @default(uuid())
  date     DateTime @unique
  name     String
  description String? @map("description")
  isOptional Boolean @default(false) @map("is_optional")

  // Nullable, mirrors ProjectHoliday.createdByEmployeeId — degrades
  // gracefully if the declaring account somehow has no linked Employee.
  createdByEmployeeId String?   @map("created_by_employee_id")
  createdBy           Employee? @relation(fields: [createdByEmployeeId], references: [id])

  @@index([date])
  @@map("holidays")
}

/// Company-wide announcements — distinct from ProjectAnnouncement, which
/// stays project-scoped. Visible to every account; only a "management"
/// account (any role other than EMPLOYEE) may create one. isBroadcast=true
/// means everyone sees it; false means only the AnnouncementRecipient rows
/// do — supports true multi-recipient targeting (several specific accounts
/// in one message), not just one person.
model Announcement {
  id             String                   @id @default(uuid())
  authorUserId   String                   @map("author_user_id")
  author         User                     @relation("AnnouncementAuthor", fields: [authorUserId], references: [id])
  title          String
  body           String
  fileUrl        String?                  @map("file_url")
  fileName       String?                  @map("file_name")
  isBroadcast    Boolean                  @default(true) @map("is_broadcast")
  recipients     AnnouncementRecipient[]
  createdAt      DateTime                 @default(now()) @map("created_at")

  @@map("announcements")
}

model AnnouncementRecipient {
  id             String       @id @default(uuid())
  announcementId String       @map("announcement_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  userId         String       @map("user_id")
  user           User         @relation("AnnouncementRecipientUser", fields: [userId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([announcementId, userId])
  @@map("announcement_recipients")
}

/// An employee-initiated "I forgot my password" request, queued for HR/Admin
/// to review. Never auto-resets anything — resolving one is just a marker
/// that HR handled it (via the existing manual reset-password flow).
model PasswordResetRequest {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation("PasswordResetRequests", fields: [userId], references: [id])
  status         String    @default("PENDING") // PENDING | RESOLVED
  resolvedById   String?   @map("resolved_by_id")
  resolvedBy     User?     @relation("PasswordResetResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("password_reset_requests")
}

model LedgerEntry {
  id          String     @id @default(uuid())
  date        DateTime   @default(now())
  account     String
  type        LedgerType
  amount      Float
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("ledger_entries")
}

model TaxRecord {
  id        String    @id @default(uuid())
  period    String
  taxType   String    @map("tax_type")
  amount    Float
  status    TaxStatus @default(UNPAID)
  dueDate   DateTime  @map("due_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("tax_records")
}

model SupportTicket {
  id          String         @id @default(uuid())
  // Nullable — the ticket form already let you leave "Customer" blank and
  // rendered it as "Guest / Unassigned", but the column itself was
  // required, so submitting without a customer crashed every time.
  customerId  String?        @map("customer_id")
  customer    Customer?      @relation(fields: [customerId], references: [id])
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  // The window the issue is expected to be worked in — set by whoever files
  // the ticket, editable afterward. Independent of createdAt/updatedAt,
  // which just track the row's own history.
  startDate   DateTime?      @map("start_date")
  endDate     DateTime?      @map("end_date")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("support_tickets")
}

model Warehouse {
  id               String                      @id @default(uuid())
  name             String
  location         String
  // REAL warehouses get a map pin (latitude/longitude); VIRTUAL ones don't
  // have a physical location at all, so those stay null.
  type             WarehouseType               @default(REAL)
  latitude         Float?
  longitude        Float?
  // Tons, always — a kg input on the frontend is divided by 1000 before it
  // ever reaches here. Float (not Int) so a kg entry that isn't an exact
  // multiple of 1000 (e.g. 1500 kg = 1.5 tons) doesn't get rounded away.
  capacity         Float
  manager          String?
  purchaseOrders    PurchaseOrder[]
  stockMovements    StockMovement[]
  productStock      WarehouseStock[]
  rawMaterialStock  WarehouseRawMaterialStock[]
  salesOrders       SalesOrder[]
  materialMovements RawMaterialMovement[]
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  @@map("warehouses")
}

model SalesOrder {
  id          String      @id @default(uuid())
  orderNo     String      @unique @map("order_no")
  customerId  String      @map("customer_id")
  customer    Customer    @relation(fields: [customerId], references: [id])
  // Nullable — rows created before this order had a real product/warehouse
  // line item at all. Stock only actually moves once the order is marked
  // DELIVERED, mirroring how a PurchaseOrder only restocks on delivery.
  productId   String?     @map("product_id")
  product     Product?    @relation(fields: [productId], references: [id])
  warehouseId String?     @map("warehouse_id")
  warehouse   Warehouse?  @relation(fields: [warehouseId], references: [id])
  quantity    Int?
  totalAmount Float       @map("total_amount")
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("sales_orders")
}

model TimeLog {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id])
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id])
  hours       Float
  date        DateTime
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // One entry per person per project per day — a member can only ever have
  // a single timesheet row for "today," found by upsert, never picked by
  // id from the client. Enforced at the DB level too, not just in code.
  @@unique([employeeId, projectId, date])
  @@map("time_logs")
}

// A date HR/Admin/PM has declared a non-working day for this specific
// project — the timesheet "Absent" check skips it, same as it already
// skips Saturdays/Sundays. Deliberately project-scoped, not a company-wide
// holiday calendar: a Project Manager can only ever speak for their own
// project, and building a real shared holiday calendar is a separate,
// bigger feature nobody has asked for yet.
model ProjectHoliday {
  id                  String   @id @default(uuid())
  projectId           String   @map("project_id")
  project             Project  @relation(fields: [projectId], references: [id])
  date                DateTime
  title               String
  createdByEmployeeId String   @map("created_by_employee_id")
  createdBy           Employee @relation(fields: [createdByEmployeeId], references: [id])
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([projectId, date])
  @@map("project_holidays")
}

// ==========================================
// SYSTEM INFRASTRUCTURE MODULES
// ==========================================

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?  @map("user_name")
  userEmail   String?  @map("user_email")
  role        String?  @map("role")
  department  String?  @map("department")
  actionType  String   @default("UPDATE") @map("action_type") // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN, EXPORT
  action      String   // Raw route or internal action code (e.g. "POST /api/hrm/employees")
  module      String   // HR, INVENTORY, FINANCE, CRM, PROJECTS, ADMIN, SETTINGS
  entityType  String?  @map("entity_type") // Employee, Payroll, Product, Order, Lead, etc.
  entityId    String?  @map("entity_id")
  description String?  // Human-readable summary of what changed
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  details     String?  @db.Text // Sanitized JSON string of payload / state diff
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([module, timestamp])
  @@index([department, timestamp])
  @@index([actionType, timestamp])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ALERT
  // Where clicking this notification should take you — e.g. the
  // announcements feed, or the specific project a deadline reminder is
  // about. Null for older rows created before this existed.
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// ENUMS

enum EmpType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum DocumentKind {
  PAYSLIP
  OFFER_LETTER
  CONFIRMATION_LETTER
  LEAVE_APPROVAL
  EMPLOYEE_PROFILE
  COMPLETION_CERTIFICATE
  // Onboarding documents — stored outside the public /uploads static path
  // (see EmployeeDocumentsController) because these carry real PII, unlike
  // an offer letter whose only secret is that it exists.
  AADHAAR_CARD
  PAN_CARD
  PASSPORT
  DRIVING_LICENCE
  ADDRESS_PROOF
  PROFILE_PHOTO
  CANCELLED_CHEQUE
  EDUCATION_CERTIFICATE
  EXPERIENCE_LETTER
  RELIEVING_LETTER
  PREVIOUS_PAYSLIP
  NDA_SIGNED
  POLICY_ACKNOWLEDGEMENT
  OTHER
}

