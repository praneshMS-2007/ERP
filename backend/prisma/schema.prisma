  ACTIVE
  INACTIVE
  ON_LEAVE
  PROBATION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  DEMO
}

enum OpportunityStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
