PORT=5000
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/database"
JWT_SECRET="generate-a-strong-random-secret-here"
GROQ_API_KEY="your-groq-api-key-here"
SMTP_USER="your-sending-gmail-address@gmail.com"
SMTP_APP_PASSWORD="a-16-character-google-app-password-no-spaces"
ENCRYPTION_KEY="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""

# --- Bulk onboarding from a Google Form (optional) ---------------------------
# Leave these out and the "Fetch new responses" button is hidden; uploading the
# exported CSV/Excel file still works. The key is a Google *service account*
# key (see the setup guide) — keep it out of git.
# Either point at the downloaded JSON file...
GOOGLE_SERVICE_ACCOUNT_KEY_FILE="./google-service-account.json"
# ...or put the key itself here (raw JSON or base64), e.g. from GCP Secret Manager:
# GOOGLE_SERVICE_ACCOUNT_JSON=""
# The long id in the response sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_ONBOARDING_SHEET_ID="your-response-sheet-id"
# GOOGLE_ONBOARDING_SHEET_TAB="Form responses 1"
